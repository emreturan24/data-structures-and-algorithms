<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.airport.ui.DashboardController" spacing="20" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
    <!-- Üst: KPI Kartları (TilesFX) -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT">
            <Label text="SİSTEM ÖZETİ" styleClass="label-section" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button text="🔄 Yenile" styleClass="btn-ghost" onAction="#onRefresh" />
        </HBox>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" vbarPolicy="NEVER">
            <HBox fx:id="tilesContainer" spacing="15" style="-fx-padding: 5 5 15 5;" />
        </ScrollPane>
    </VBox>

    <!-- Alt: Aktif Listeler -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Sol: Uçuşlar -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10" prefWidth="500">
            <HBox alignment="CENTER_LEFT">
                <Label text="AKTİF UÇUŞLAR" styleClass="label-section" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label fx:id="flightCountBadge" text="0 Uçuş" styleClass="badge-business" />
            </HBox>
            <ListView fx:id="flightListView" VBox.vgrow="ALWAYS" />
        </VBox>

        <!-- Sağ: Kritik Kuyruklar -->
        <VBox spacing="20" prefWidth="350">
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <Circle radius="4" fill="#ff3b5c" />
                    <Label text=" GÜVENLİK HAVUZU" styleClass="label-section" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Label fx:id="securityPoolCount" text="0" style="-fx-font-weight:bold; -fx-text-fill:#ff3b5c;" />
                </HBox>
                <ListView fx:id="securityPoolList" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <Circle radius="4" fill="#ffb830" />
                    <Label text=" BEKLEME KUYRUĞU" styleClass="label-section" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Label fx:id="waitingCount" text="0" style="-fx-font-weight:bold; -fx-text-fill:#ffb830;" />
                </HBox>
                <ListView fx:id="waitingQueueList" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>
    </HBox>
</VBox>