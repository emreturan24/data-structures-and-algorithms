<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.airport.ui.StackController" spacing="20" style="-fx-padding: 20;" HBox.hgrow="ALWAYS">
    <!-- Sol: Stack Görselleştirme -->
    <VBox spacing="15" HBox.hgrow="ALWAYS">
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
            <ComboBox fx:id="flightCombo" promptText="Simüle Edilecek Uçuş..." prefWidth="250" />
            <Button text="Uçağı Yükle (Ağır Altta)" styleClass="btn-primary" onAction="#onLoadFlight" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="stackSizeLabel" text="Stack: 0 öğe" style="-fx-text-fill:-accent-purple; -fx-font-weight:bold;" />
        </HBox>

        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color:transparent;">
            <!-- Kartların AnimateFX SlideInUp ile fırlatıldığı Stack taşıyıcısı -->
            <VBox fx:id="stackVisualBox" id="stack-container" spacing="5" minHeight="500" />
        </ScrollPane>

        <HBox alignment="CENTER">
            <Label fx:id="logLabel" text="Simülasyon bekleniyor..." style="-fx-text-fill:-text-muted;" />
        </HBox>
    </VBox>

    <!-- Sağ: Kontroller ve Loglar -->
    <VBox spacing="20" minWidth="300" maxWidth="300">
        <VBox styleClass="card" spacing="12">
            <Label text="STACK İSTATİSTİĞİ" styleClass="label-section" />
            <Label fx:id="infoFlight" text="Uçuş: —" style="-fx-text-fill:-accent-cyan;" />
            <Label fx:id="infoSize" text="Öğe sayısı: 0" />
            <Label fx:id="infoWeight" text="Toplam ağırlık: 0 kg" />
            <Separator />
            <Label fx:id="infoTop" text="Üstteki: —" style="-fx-font-size:11px;" />
            <Label fx:id="infoBottom" text="Alttaki: —" style="-fx-font-size:11px;" />
        </VBox>

        <VBox styleClass="card" spacing="12">
            <Label text="BOŞALTMA (LIFO) KONTROLLERİ" styleClass="label-section" />
            <Button text="⬇ Tek Bagaj İndir (Pop)" styleClass="btn-amber" maxWidth="Infinity" onAction="#onUnloadStep" />
            <Button text="⏬ Tümünü İndir (İniş)" styleClass="btn-success" maxWidth="Infinity" onAction="#onUnloadAll" />
        </VBox>

        <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
            <Label text="LIFO BOŞALTMA LOGU" styleClass="label-section" />
            <ListView fx:id="unloadLogView" VBox.vgrow="ALWAYS" />
            <Button text="Logu Temizle" styleClass="btn-ghost" maxWidth="Infinity" onAction="#onClearLog" />
        </VBox>

        <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
            <Label text="ÖNCELİK KUYRUĞU (VIP İlk)" styleClass="label-section" />
            <ListView fx:id="priorityQueueView" VBox.vgrow="ALWAYS" />
        </VBox>
    </VBox>
</HBox>