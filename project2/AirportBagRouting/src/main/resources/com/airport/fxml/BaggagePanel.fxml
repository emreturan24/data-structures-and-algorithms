<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.airport.ui.BaggageController" spacing="20" style="-fx-padding: 20;" HBox.hgrow="ALWAYS">
    <!-- Sol: Arama ve Tablo -->
    <VBox spacing="15" HBox.hgrow="ALWAYS">
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
            <TextField fx:id="searchId" promptText="🔍 Bagaj ID Ara..." prefWidth="200" />
            <Button text="Ara" styleClass="btn-primary" onAction="#onSearch" />
            <Separator orientation="VERTICAL" />
            <Button text="Tümü" styleClass="btn-ghost" onAction="#onFilterAll" />
            <Button text="Check-in" styleClass="btn-ghost" onAction="#onFilterCheckin" />
            <Button text="Kargo" styleClass="btn-ghost" onAction="#onFilterCargo" />
            <Button text="Tehlikeli" style="-fx-text-fill:#ff3b5c;" styleClass="btn-ghost" onAction="#onFilterDanger" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="totalLabel" text="Toplam: 0 bagaj" style="-fx-text-fill: -text-muted;" />
        </HBox>

        <VBox styleClass="card" VBox.vgrow="ALWAYS">
            <TableView fx:id="baggageTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="100" />
                    <TableColumn fx:id="colPassenger" text="YOLCU" prefWidth="80" />
                    <TableColumn fx:id="colFlight" text="UÇUŞ" prefWidth="80" />
                    <TableColumn fx:id="colWeight" text="AĞIRLIK" prefWidth="70" />
                    <TableColumn fx:id="colClass" text="SINIF" prefWidth="90" />
                    <TableColumn fx:id="colStatus" text="DURUM" prefWidth="140" />
                    <TableColumn fx:id="colDanger" text="GÜVENLİK" prefWidth="100" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <!-- Sağ: Detay ve Check-in Formu -->
    <VBox spacing="20" minWidth="320" maxWidth="320">
        <VBox styleClass="card" spacing="12">
            <Label text="SEÇİLİ BAGAJ DETAYI" styleClass="label-section" />
            <Label fx:id="detailId" text="ID: —" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:-accent-cyan;" />
            <Label fx:id="detailPass" text="Yolcu: —" />
            <Label fx:id="detailFlight" text="Uçuş: —" />
            <HBox spacing="10">
                <Label fx:id="detailWt" text="Ağırlık: —" />
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="detailClass" text="Sınıf: —" />
            </HBox>
            <Label fx:id="detailStat" text="Durum: —" />
            <Label fx:id="detailDanger" text="" style="-fx-text-fill:-accent-red; -fx-font-weight:bold;" />

            <Separator />
            <Label text="İzleme Noktaları" style="-fx-text-fill:-text-muted; -fx-font-size:11px;" />
            <VBox fx:id="timelineBox" spacing="5" />
            <Separator />

            <HBox spacing="10">
                <ComboBox fx:id="statusCombo" promptText="Yeni Durum Seç" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                <Button text="Uygula" styleClass="btn-primary" onAction="#onUpdateStatus" />
            </HBox>
        </VBox>

        <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
            <Label text="YENİ CHECK-İN" styleClass="label-section" />
            <TextField fx:id="ciPassenger" promptText="Yolcu ID (Örn: P012)" />
            <ComboBox fx:id="ciFlightCombo" promptText="Uçuş Seçin" maxWidth="Infinity" />
            <HBox spacing="10">
                <TextField fx:id="ciWeight" promptText="Ağırlık (kg)" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="ciClassCombo" promptText="Sınıf" prefWidth="120" />
            </HBox>
            <CheckBox fx:id="ciDangerous" text="Tehlikeli Madde İçeriyor" style="-fx-text-fill: -text-primary;" />
            <ComboBox fx:id="ciDangerCombo" promptText="Kategori Belirle" maxWidth="Infinity" disable="true" />
            <Pane VBox.vgrow="ALWAYS" />
            <Button text="Check-In Tamamla" styleClass="btn-success" maxWidth="Infinity" onAction="#onCheckIn" />
        </VBox>
    </VBox>
</HBox>