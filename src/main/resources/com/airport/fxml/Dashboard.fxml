<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!--
    Dashboard.fxml — installStableTooltip mimarisi
    ─────────────────────────────────────────────────────
    TOOLTIP KURALLARI:
      • FXML içinde <tooltip> bloğu YOKTUR — DashboardController'daki
        installStableTooltip() ile programatik olarak kurulur.

    fx:id eklenenler / güncellenenler:
      securityPoolCard    → Güvenlik Havuzu kartının tamamı
      waitingQueueCard    → Bekleme Kuyruğu kartının tamamı
      refreshBtn          → ★ YENİ — "🔄 Yenile" butonu (tooltip migrasyonu)
      activeFlightsLabel  → ★ YENİ — "AKTİF UÇUŞLAR" etiketi (tooltip eklendi)
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.airport.ui.DashboardController"
      spacing="20" style="-fx-padding: 20;"
      VBox.vgrow="ALWAYS">

    <!-- ── Üst: KPI Kartları ── -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT">
            <Label text="SİSTEM ÖZETİ" styleClass="label-section" />
            <Pane HBox.hgrow="ALWAYS" />
            <!--
                fx:id="refreshBtn" eklendi — FXML <tooltip> KALDIRILDI.
                Tooltip artık DashboardController.setupControlTooltips() içinde
                installStableTooltip() ile kurulur.
            -->
            <Button fx:id="refreshBtn" text="🔄 Yenile"
                    styleClass="btn-ghost" onAction="#onRefresh" />
        </HBox>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;" vbarPolicy="NEVER">
            <HBox fx:id="tilesContainer" spacing="15"
                  style="-fx-padding: 5 5 15 5;" />
        </ScrollPane>
    </VBox>

    <!-- ── Alt: Aktif Listeler ── -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Sol: Uçuşlar -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="10" prefWidth="500">
            <HBox alignment="CENTER_LEFT">
                <!--
                    fx:id="activeFlightsLabel" eklendi — tooltip
                    DashboardController.setupControlTooltips() içinde kurulur.
                -->
                <Label fx:id="activeFlightsLabel"
                       text="AKTİF UÇUŞLAR" styleClass="label-section"
                       maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Label fx:id="flightCountBadge" text="0 Uçuş"
                       styleClass="badge-business" />
            </HBox>
            <ListView fx:id="flightListView" VBox.vgrow="ALWAYS" />
        </VBox>

        <!-- Sağ: Kritik Kuyruklar -->
        <VBox spacing="20" prefWidth="350">

            <!--
                Güvenlik Havuzu kartı
                fx:id="securityPoolCard" → DashboardController'da tüm karta
                installStableTooltip() uygulanır.
            -->
            <VBox fx:id="securityPoolCard" styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Circle radius="4" fill="#ff3b5c" />
                    <Label text="GÜVENLİK HAVUZU" styleClass="label-section"
                           maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    <Label fx:id="securityPoolCount" text="0"
                           style="-fx-font-weight:bold; -fx-text-fill:#ff3b5c;" />
                </HBox>
                <ListView fx:id="securityPoolList" VBox.vgrow="ALWAYS" />
            </VBox>

            <!--
                Bekleme Kuyruğu kartı
                fx:id="waitingQueueCard" → aynı şekilde tüm karta tooltip takılır.
            -->
            <VBox fx:id="waitingQueueCard" styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Circle radius="4" fill="#ffb830" />
                    <Label text="BEKLEME KUYRUĞU" styleClass="label-section"
                           maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    <Label fx:id="waitingCount" text="0"
                           style="-fx-font-weight:bold; -fx-text-fill:#ffb830;" />
                </HBox>
                <ListView fx:id="waitingQueueList" VBox.vgrow="ALWAYS" />
            </VBox>

        </VBox>
    </HBox>
</VBox>
