<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    FlightPanel.fxml — Uçuş Takvimi
    ★ installStableTooltip MİGRASYONU (v2):
      - Tüm <tooltip> blokları KALDIRILDI (14 adet).
      - Tooltip'ler FlightController.setupControlTooltips() içinde
        installStableTooltip() ile programatik olarak kurulur.
      - fx:id eklenenler:
          refreshFlightBtn   → "🔄 Yenile" butonu
          boardingBtn        → "Binişi Başlat" butonu
          departBtn          → "Uçağı Kaldır" butonu
          cancelFlightBtn    → "Uçuşu İptal Et" butonu
      - Layout, boyut, renk, buton sırası — hiçbir şey değişmedi.
-->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.airport.ui.FlightController"
      spacing="20" style="-fx-padding: 20;" HBox.hgrow="ALWAYS">

    <!-- Sol: Tablo -->
    <VBox spacing="15" HBox.hgrow="ALWAYS">
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
            <!-- FXML <tooltip> KALDIRILDI — FlightController'da installStableTooltip -->
            <TextField fx:id="searchField" promptText="🔍 Uçuş veya Rota Ara..." prefWidth="250" />
            <Pane HBox.hgrow="ALWAYS" />
            <!-- ★ fx:id="refreshFlightBtn" eklendi — FXML <tooltip> KALDIRILDI -->
            <Button fx:id="refreshFlightBtn"
                    text="🔄 Yenile" styleClass="btn-ghost" onAction="#onRefresh" />
        </HBox>

        <VBox styleClass="card" VBox.vgrow="ALWAYS">
            <!-- FXML <tooltip> KALDIRILDI — FlightController'da installStableTooltip -->
            <TableView fx:id="flightTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNo"     text="UÇUŞ NO" prefWidth="80"  />
                    <TableColumn fx:id="colRoute"  text="ROTA"    prefWidth="120" />
                    <TableColumn fx:id="colDep"    text="KALKIŞ"  prefWidth="100" />
                    <TableColumn fx:id="colArr"    text="VARIŞ"   prefWidth="100" />
                    <TableColumn fx:id="colLoad"   text="DOLULUK" prefWidth="150" />
                    <TableColumn fx:id="colStatus" text="DURUM"   prefWidth="90"  />
                    <TableColumn fx:id="colGate"   text="KAPI"    prefWidth="60"  />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <!-- Sağ: Detay ve İşlemler -->
    <VBox spacing="20" minWidth="300" maxWidth="300">

        <!--
            flightDetailCard — fx:id tanımlı.
            FlightController.setupCardTooltips() → installStableTooltip ile kart tooltip'i.
            İçindeki bireysel kontroller setupControlTooltips() ile ayrı kurulur.
        -->
        <VBox fx:id="flightDetailCard" styleClass="card" spacing="12">
            <Label text="UÇUŞ DETAYI" styleClass="label-section" />

            <!-- FXML <tooltip> blokları KALDIRILDI — FlightController'da installStableTooltip -->
            <Label fx:id="detailFlightNo" text="—"
                   style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:-accent-blue;" />
            <Label fx:id="detailRoute"  text="Rota: —" />
            <Label fx:id="detailDep"    text="Kalkış: —" />
            <Label fx:id="detailStatus" text="Durum: —" style="-fx-font-weight:bold;" />

            <Separator />
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="detailCapacity" text="Kapasite: —" style="-fx-font-size:11px;" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label fx:id="capacityPct" text="0%"
                       style="-fx-text-fill:-accent-blue; -fx-font-weight:bold;" />
            </HBox>
            <ProgressBar fx:id="capacityBar" progress="0" maxWidth="Infinity" prefHeight="8" />

            <Separator />

            <!-- ★ fx:id'ler eklendi — FXML <tooltip> blokları KALDIRILDI -->
            <Button fx:id="boardingBtn"
                    text="Binişi Başlat (Boarding)"
                    styleClass="btn-primary" maxWidth="Infinity" onAction="#onStartBoarding" />
            <Button fx:id="departBtn"
                    text="Uçağı Kaldır (Depart)"
                    styleClass="btn-amber" maxWidth="Infinity" onAction="#onDepartNext" />
            <Button fx:id="cancelFlightBtn"
                    text="Uçuşu İptal Et"
                    styleClass="btn-danger" maxWidth="Infinity" onAction="#onCancelFlight" />
        </VBox>

        <!--
            flightBaggageCard — fx:id tanımlı.
            FlightController.setupCardTooltips() → installStableTooltip ile kart tooltip'i.
        -->
        <VBox fx:id="flightBaggageCard" styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
            <Label text="KAYITLI BAGAJLAR" styleClass="label-section" />
            <!-- FXML <tooltip> KALDIRILDI — FlightController'da installStableTooltip -->
            <ListView fx:id="flightBaggageList" VBox.vgrow="ALWAYS" />
        </VBox>

    </VBox>
</HBox>
